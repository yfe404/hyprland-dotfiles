# Ghost in the Shell (1995) cava — hexes mirror theme/palette.css

[general]
framerate = 60
autosens = 1

[input]
# audio actually plays through the HDMI sink, not the "default" analog one
# (find yours: pactl list sinks short — append .monitor)
method = pulse
source = alsa_output.pci-0000_c3_00.1.hdmi-stereo.monitor

[color]
gradient = 1
gradient_count = 5
# bottom -> top: phosphor green -> teal -> cyan -> blue -> amber tips
gradient_color_1 = '#7af0c8'
gradient_color_2 = '#4dd8c0'
gradient_color_3 = '#5ecfdc'
gradient_color_4 = '#6aaede'
gradient_color_5 = '#ffb454'

[smoothing]
noise_reduction = 77
