// Ghost in the Shell (1995) fastfetch — hexes mirror theme/palette.css
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "38;2;122;240;200",
      "2": "38;2;138;118;184"
    },
    "padding": { "top": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;122;240;200",
      "title": "38;2;138;118;184"
    }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "󰣇 os" },
    { "type": "kernel", "key": "󰌽 kernel" },
    { "type": "wm", "key": " wm" },
    { "type": "terminal", "key": " term" },
    { "type": "shell", "key": " shell" },
    { "type": "packages", "key": "󰏖 pkgs" },
    { "type": "uptime", "key": "󰅐 up" },
    { "type": "cpu", "key": " cpu" },
    { "type": "gpu", "key": "󰢮 gpu" },
    { "type": "memory", "key": " mem" },
    { "type": "separator", "string": "─" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
